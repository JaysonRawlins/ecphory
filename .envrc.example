# Copy to .envrc (git-ignored), then `direnv allow`.
#
# swamp must run here as the maintainer's own swamp-club account. This machine
# may also hold another account's login in ~/.config/swamp/auth.json, which swamp uses
# whenever SWAMP_API_KEY is unset or empty, so the personal config dir below
# keeps that file out of reach and a missing key fails closed. Run swamp through
# scripts/swamp, which refuses unless both of these are set.
export SWAMP_CONFIG_DIR="$HOME/.config/swamp-personal"
unset SWAMP_API_KEY_FILE SWAMP_SIGNIN_TOKEN

# The key lives in Doppler, never in a file in this repo.
SWAMP_API_KEY="$(doppler secrets get SWAMP_API_KEY --plain --project swamp --config personal 2>/dev/null || true)"
export SWAMP_API_KEY
[ -n "$SWAMP_API_KEY" ] || log_error "SWAMP_API_KEY not readable from Doppler (project swamp, config personal); swamp will refuse to run"
